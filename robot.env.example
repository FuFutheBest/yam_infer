# Copy to robot.env (not in git) and adjust. Read by scripts/run_robot.sh.
HW_CONFIG=configs/hardware.yaml
# The model (and its task / action_mode) is set in configs/models.yaml.
# Uncomment only to try another file of the same kind without editing it:
# CKPT=models/act_v2_delta_s15k.pt
# pi05 policy server (started by run_robot.sh when models.yaml has format: pi05 + model_dir):
# openpi checkout with its uv .venv (default: ~/fufu/astra_inference_train/openpi)
# export OPENPI_DIR=$HOME/fufu/astra_inference_train/openpi
# GPU memory share of the server (default 0.5 of the card; JAX alone would take 0.75)
# export XLA_PYTHON_CLIENT_MEM_FRACTION=0.5
# camera serial override (otherwise configs/hardware.yaml `cameras:`)
# export YAM_LEFT_CAM_SERIAL=262622275249
# export YAM_RIGHT_CAM_SERIAL=262622272890
